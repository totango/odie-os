{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-odie-kg",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OdieKgAccount", "OdieKgGatekeeper"] }
  ],
  "vars": {
    "BASE_URL": "https://odie-os.odie-os.workers.dev/gatekeeper/odie-kg",
    "ODIE_KG_MCP_URL": "https://api-agents.unison.totango.com/api/mcp/odie",
    "MCP_CLIENT_NAME": "Odie OS Totango Knowledge Graph",
    "MCP_ALLOW_INSECURE": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
