{
  "name": "@gadgets/gatekeeper-odie-kg",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "wrangler deploy",
    "build": "pnpm exec capnweb-validate build --out .wrangler/validate && tsc",
    "types:check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:run": "vitest run",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@gadgets/backend-utils": "workspace:*",
    "@gadgets/mcp-shared": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "catalog:",
    "capnweb-validate": "catalog:"
  },
  "devDependencies": {
    "@gadgets/scripts": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@gadgets/integration-tests": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
