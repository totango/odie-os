{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-jarvis",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "enhanced_error_serialization", "global_fetch_strictly_public"],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
  "workers_dev": false,
  "preview_urls": false,
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["JarvisGatekeeper"] },
    { "tag": "v2", "new_sqlite_classes": ["JarvisPolicy"] }
  ],
  "vars": {
    "REQUEST_BUILD_WORKSHOP_ORIGIN": "https://odie-os.odie-os.workers.dev",
    "REQUEST_BUILD_SLACK_CHANNEL": "C09EW0T5VB5",
    "REQUEST_BUILD_SLACK_TEAM_ID": "T029S9MAU",
    "REQUEST_BUILD_SLACK_BOT_USER_ID": "U0ASJH874Q2",
    "REQUEST_BUILD_SLACK_BOT_ID": "B0ASN51AUJ0",
    "REQUEST_BUILD_SLACK_CHANNEL_TYPE": "public",
    "REQUEST_BUILD_NOTIFIER_GENERATION": "jarvis-unilyst-prs-v1",
    "JARVIS_MCP_URL": "https://jarvis.unison.totango.com/api/jarvis/mcp",
    "JARVIS_TRUST_ANNOTATIONS": "true",
    "PRODUCT_FEEDBACK_MCP_URL": "https://jarvis.unison.totango.com/api/jarvis/product-feedback/mcp"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
