{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-google",
  "main": ".wrangler/validate/src/google.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  "preview_urls": false,
  "vars": {
    "BASE_URL": "https://odie-os-native-api.odie-os.workers.dev/gatekeeper/google"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["UserAccount", "GmailGatekeeperImpl"] },
    { "tag": "v1", "new_sqlite_classes": ["BigQueryGatekeeperImpl"] },
    { "tag": "v2", "new_sqlite_classes": ["GoogleCalendarGatekeeperImpl"] },
    { "tag": "v3", "new_sqlite_classes": ["GoogleSheetsGatekeeperImpl"] },
    { "tag": "v4", "new_sqlite_classes": ["GoogleDocGatekeeperImpl"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
