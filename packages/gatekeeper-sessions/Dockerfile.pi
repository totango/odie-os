FROM ghcr.io/astral-sh/uv@sha256:4c55b48c2750a257fa631f31d8362445d9f880ba219d871c33153b165a83c81a AS uv

FROM docker.io/cloudflare/sandbox@sha256:6c8e082085d0861ad3b359041abd4cdc750f5b0e29e7aa82bb87a9b557dbdc60

LABEL org.opencontainers.image.source="https://github.com/totango/odie-os"

ARG NODE_VERSION=24.14.0
ARG PNPM_PACKAGE_MANAGER=pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c
ARG REPOSITORY_PNPM_PACKAGE_MANAGER=pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72
ARG OPENCODE_VERSION=1.18.15
ARG PI_VERSION=0.84.2
ARG PI_MCP_ADAPTER_VERSION=2.26.0
ARG PRIME_AGENT_VERSION=0.8.0
ARG VALHALLA_VERSION=0.3.0
ARG CODE_SERVER_VERSION=4.133.0

# Node is installed alongside the base image's global tools. Replacing /usr/local would remove the
# pinned OpenCode installation inherited from the matching Sandbox image.
ADD --checksum=sha256:dbf5b8665dec15e59e6359a517fefb47b23fdb9152d8def975b9bca3dfc6d355 \
    https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz \
    /tmp/node.tar.gz

# Browser VS Code and its reviewed baseline extensions are fetched only at image build time. Every
# artifact is version and digest pinned; repository recommendations never authorize online installs.
ADD --checksum=sha256:a4e0f8f8c76e7de8e7424289f74e507af4c97bfe104c3e8ee272b8cc7b46c6f1 \
    https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz \
    /tmp/code-server.tar.gz
ADD --checksum=sha256:ca5334d46f6a39079e751ef4601bfc9f86bc3a46483e87291ec609239d161308 \
    https://open-vsx.org/api/dbaeumer/vscode-eslint/3.0.34/file/dbaeumer.vscode-eslint-3.0.34.vsix \
    /tmp/vscode-eslint.vsix
ADD --checksum=sha256:fb730ea4306d09cdc0a3aaa9e9baae28058cc97a4fbfce8b056b377a0639a9fe \
    https://open-vsx.org/api/esbenp/prettier-vscode/12.4.0/file/esbenp.prettier-vscode-12.4.0.vsix \
    /tmp/prettier-vscode.vsix
ADD --checksum=sha256:842bf9abd3eb24ace6bc482127ed8ae44a6759036dfaa4055c78599662bf45de \
    https://open-vsx.org/api/redhat/vscode-yaml/1.25.2026082008/file/redhat.vscode-yaml-1.25.2026082008.vsix \
    /tmp/vscode-yaml.vsix
ADD --checksum=sha256:c7744af4bf72978f5792624a71c80e2b622a1118574fada3a903d70ac03d5bca \
    https://open-vsx.org/api/ms-python/debugpy/linux-x64/2026.6.0/file/ms-python.debugpy-2026.6.0@linux-x64.vsix \
    /tmp/vscode-python-debugpy.vsix
ADD --checksum=sha256:d9d96596a096d22c2ba0022c402165e0252af59cab46b78e443588e2cbed98dc \
    https://open-vsx.org/api/ms-python/vscode-python-envs/1.36.0/file/ms-python.vscode-python-envs-1.36.0.vsix \
    /tmp/vscode-python-envs.vsix
ADD --checksum=sha256:232aeafb01f069824fdd92d3e628c1c442bbcfa1d3cc945ff97076340bb2b4a6 \
    https://open-vsx.org/api/ms-python/python/2026.4.0/file/ms-python.python-2026.4.0.vsix \
    /tmp/vscode-python.vsix
ADD --checksum=sha256:9f5959fb17ba0a8dbd804387ddda50975fcaa9dd5267aa33eaaa89912072aacb \
    https://open-vsx.org/api/golang/Go/0.56.0/file/golang.Go-0.56.0.vsix \
    /tmp/vscode-go.vsix
ADD --checksum=sha256:207c80dd995e103c271fae8c8ffb8528d86c15ab0c4eef1be23ba1792e5b115c \
    https://open-vsx.org/api/rust-lang/rust-analyzer/0.4.3024/file/rust-lang.rust-analyzer-0.4.3024.vsix \
    /tmp/vscode-rust-analyzer.vsix

COPY --from=uv /uv /uvx /bin/
COPY pi-image/package.json pi-image/package-lock.json pi-image/build-valhalla-opencode.mjs \
    pi-image/verify-mcp-app-fail-closed.mjs /opt/odie-pi/
COPY pi-image/prime-kernel-requirements.txt /opt/odie-prime-agent/requirements.txt

ENV PATH="/opt/node/bin:${PATH}" \
    COREPACK_HOME="/opt/odie-corepack" \
    COREPACK_ENABLE_NETWORK="0"

# Prime Agent uses ripgrep for fast model-driven repository search. Install it in the image because
# coding sessions run offline and cannot satisfy the CLI's best-effort package-manager fallback.
# Sandbox processes use the launcher's compatibility PATH rooted at /usr/local/bin rather than the
# image ENV PATH, so the reviewed Node/Corepack tools are mirrored there without removing global apps.
RUN mkdir -p /opt/node \
    && tar -xzf /tmp/node.tar.gz -C /opt/node --strip-components=1 \
    && rm -f /tmp/node.tar.gz \
    && printf '%s\n' 'export PATH="/opt/node/bin:$PATH"' > /etc/profile.d/odie-node.sh \
    && chmod 644 /etc/profile.d/odie-node.sh \
    && corepack enable pnpm \
    && COREPACK_ENABLE_NETWORK=1 corepack install --global "$REPOSITORY_PNPM_PACKAGE_MANAGER" \
    && COREPACK_ENABLE_NETWORK=1 corepack install --global "$PNPM_PACKAGE_MANAGER" \
    && for command in node npm npx corepack pnpm pnpx; do \
      ln -sfn "/opt/node/bin/$command" "/usr/local/bin/$command"; \
    done \
    && apt-get update \
    && apt-get install --yes --no-install-recommends ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/odie-code-server/extensions /tmp/odie-code-server-user-data \
    && tar -xzf /tmp/code-server.tar.gz -C /opt/odie-code-server --strip-components=1 \
    && ln -s /opt/odie-code-server/bin/code-server /usr/local/bin/code-server \
    && EXTENSIONS_GALLERY='{}' code-server --user-data-dir /tmp/odie-code-server-user-data --extensions-dir /opt/odie-code-server/extensions --install-extension /tmp/vscode-eslint.vsix \
    && EXTENSIONS_GALLERY='{}' code-server --user-data-dir /tmp/odie-code-server-user-data --extensions-dir /opt/odie-code-server/extensions --install-extension /tmp/prettier-vscode.vsix \
    && EXTENSIONS_GALLERY='{}' code-server --user-data-dir /tmp/odie-code-server-user-data --extensions-dir /opt/odie-code-server/extensions --install-extension /tmp/vscode-yaml.vsix \
    && EXTENSIONS_GALLERY='{}' code-server --user-data-dir /tmp/odie-code-server-user-data --extensions-dir /opt/odie-code-server/extensions --install-extension /tmp/vscode-python-debugpy.vsix \
    && EXTENSIONS_GALLERY='{}' code-server --user-data-dir /tmp/odie-code-server-user-data --extensions-dir /opt/odie-code-server/extensions --install-extension /tmp/vscode-python-envs.vsix \
    && EXTENSIONS_GALLERY='{}' code-server --user-data-dir /tmp/odie-code-server-user-data --extensions-dir /opt/odie-code-server/extensions --install-extension /tmp/vscode-python.vsix \
    && EXTENSIONS_GALLERY='{}' code-server --user-data-dir /tmp/odie-code-server-user-data --extensions-dir /opt/odie-code-server/extensions --install-extension /tmp/vscode-go.vsix \
    && EXTENSIONS_GALLERY='{}' code-server --user-data-dir /tmp/odie-code-server-user-data --extensions-dir /opt/odie-code-server/extensions --install-extension /tmp/vscode-rust-analyzer.vsix \
    && rm -f /tmp/code-server.tar.gz /tmp/*.vsix \
    && rm -rf \
      /root/.config/code-server \
      /root/.local/share/code-server \
      /tmp/odie-code-server-user-data

# Package lifecycle scripts stay disabled. ZeroMQ runs its pinned native installer explicitly. The
# Prime kernel uses a pinned uv image, exact Python version, and hash-locked Python dependencies.
RUN test "$(node --version)" = "v${NODE_VERSION}" \
    && test "pnpm@$(pnpm --version)" = "${PNPM_PACKAGE_MANAGER%%+*}" \
    && test "$(env PATH=/usr/local/bin:/bin:/usr/bin node --version)" = "v${NODE_VERSION}" \
    && test "pnpm@$(env PATH=/usr/local/bin:/bin:/usr/bin pnpm --version)" = "${PNPM_PACKAGE_MANAGER%%+*}" \
    && test "$(node -p 'process.arch')" = "x64" \
    && test "$(uname -m)" = "x86_64" \
    && for command in ps pgrep pkill setsid stdbuf timeout tail tee flock du df truncate jq curl git bash tini; do command -v "$command" >/dev/null; done \
    && npm ci --prefix /opt/odie-pi --ignore-scripts \
    && node /opt/odie-pi/node_modules/zeromq/script/install.js \
    && node -e 'require("/opt/odie-pi/node_modules/zeromq")' \
    && UV_PYTHON_INSTALL_DIR=/opt/odie-prime-agent/python uv python install 3.11.14 \
    && UV_PYTHON_INSTALL_DIR=/opt/odie-prime-agent/python uv venv --python 3.11.14 /opt/odie-prime-agent/kernel-venv \
    && uv pip install --python /opt/odie-prime-agent/kernel-venv/bin/python --require-hashes --no-deps -r /opt/odie-prime-agent/requirements.txt \
    && uv pip install --python /opt/odie-prime-agent/kernel-venv/bin/python --no-deps --no-build-isolation /opt/odie-pi/node_modules/prime-agent/dist/prime-agent-runtime \
    && /opt/odie-prime-agent/kernel-venv/bin/python -m IPython -c 'import ipykernel, rlm, rlm.mcp; assert 6 * 7 == 42' \
    && node /opt/odie-pi/build-valhalla-opencode.mjs \
    && ln -s /opt/odie-pi/node_modules/@earendil-works/pi-coding-agent/dist/cli.js /usr/local/bin/pi \
    && ln -s /opt/odie-pi/node_modules/prime-agent/dist/bundle/cli.js /usr/local/bin/prime-agent \
    && opencode --version \
    && test "$(node -p "require('/usr/local/lib/node_modules/opencode-ai/package.json').version")" = "$OPENCODE_VERSION" \
    && pi --version \
    && prime-agent --version \
    && rg --version \
    && test "$(node -p "require('/opt/odie-code-server/package.json').version")" = "$CODE_SERVER_VERSION" \
    && printf '%s\n' 'verified code-server package version' \
    && printf '%s\n' 'bind-addr: 127.0.0.1:3000' 'auth: none' 'cert: false' > /tmp/odie-code-server-config.yaml \
    && test "$(code-server --config /tmp/odie-code-server-config.yaml --user-data-dir /tmp/odie-code-server-user-data --extensions-dir /opt/odie-code-server/extensions --list-extensions --show-versions | sha256sum | cut -d ' ' -f1)" = "65e3a533e0df9f58a8f81ba5ac430cea826cae6eb507dccdc93498228783c068" \
    && printf '%s\n' 'verified code-server extension set' \
    && test "$(node -p "require('/opt/odie-pi/node_modules/@earendil-works/pi-coding-agent/package.json').version")" = "$PI_VERSION" \
    && test "$(node -p "require('/opt/odie-pi/node_modules/pi-mcp-adapter/package.json').version")" = "$PI_MCP_ADAPTER_VERSION" \
    && test "$(node -p "require('/opt/odie-pi/node_modules/prime-agent/package.json').version")" = "$PRIME_AGENT_VERSION" \
    && test "$(node -p "require('/opt/odie-pi/node_modules/@howlerops/valhalla/package.json').version")" = "$VALHALLA_VERSION" \
    && test "$(find /opt/odie-pi/node_modules/@howlerops/valhalla/pi/prompts -name '*.md' -type f | wc -l)" = "7" \
    && test "$(find /opt/odie-valhalla/opencode/command -name '*.md' -type f | wc -l)" = "8" \
    && test -f /opt/odie-valhalla/opencode/skills/vegvisir/SKILL.md \
    && node \
      --import /opt/odie-pi/node_modules/@earendil-works/pi-coding-agent/node_modules/jiti/lib/jiti-register.mjs \
      --eval 'const assert = require("node:assert/strict"); import("/opt/odie-pi/node_modules/pi-mcp-adapter/index.ts").then((module) => assert.equal(typeof (module.createMcpAdapter ?? module.default?.createMcpAdapter), "function"))' \
    && node \
      --import /opt/odie-pi/node_modules/@earendil-works/pi-coding-agent/node_modules/jiti/lib/jiti-register.mjs \
      /opt/odie-pi/verify-mcp-app-fail-closed.mjs \
    && rm -rf \
      /root/.npm \
      /root/.cache/uv \
      /root/.ipython \
      /root/.config/code-server \
      /root/.local/share/code-server \
      /tmp/jiti \
      /tmp/odie-code-server-config.yaml \
      /tmp/odie-code-server-user-data

LABEL org.opencontainers.image.source="https://github.com/totango/odie-os" \
      org.opencontainers.image.description="Odie OS coding-session sandbox with OpenCode, Pi, Prime Agent, browser VS Code, Valhalla, and pi-mcp-adapter"
