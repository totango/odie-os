{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-sessions",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["nodejs_compat", "allow_irrevocable_stub_storage", "global_fetch_strictly_public"],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BASE_URL": "https://odie-os.odie-os.workers.dev/gatekeeper/sessions",
    "EDITOR_BASE_URL": "https://odie-os-gk-sessions.odie-os.workers.dev",
    "SESSION_ALLOWED_ORIGIN": "https://odie-os.odie-os.workers.dev",
    "CODING_SESSION_PI_RUNTIME_ENABLED": "true",
    "CODING_SESSION_DURABLE_LIFECYCLE_ENABLED": "true",
    "APPLICATION_PREVIEW_ENABLED": "false"
  },
  "containers": [
    {
      "class_name": "CodingSessionSandbox",
      "image": "registry.cloudflare.com/286469790a4362a2e194b32045c5eca7/odie-os-coding-session@sha256:a3ed11cff1c11faf8efd0fe4d1cebd7595026f791b8a6bc69b986e7ff9c5b1c1",
      "instance_type": "standard-1",
      "max_instances": 20
    },
    {
      "class_name": "CodingSessionSandboxStandard2",
      "image": "registry.cloudflare.com/286469790a4362a2e194b32045c5eca7/odie-os-coding-session@sha256:a3ed11cff1c11faf8efd0fe4d1cebd7595026f791b8a6bc69b986e7ff9c5b1c1",
      "instance_type": "standard-2",
      "max_instances": 8
    },
    {
      "class_name": "CodingSessionSandboxStandard3",
      "image": "registry.cloudflare.com/286469790a4362a2e194b32045c5eca7/odie-os-coding-session@sha256:a3ed11cff1c11faf8efd0fe4d1cebd7595026f791b8a6bc69b986e7ff9c5b1c1",
      "instance_type": "standard-3",
      "max_instances": 4
    },
    {
      "class_name": "CodingSessionSandboxStandard4",
      "image": "registry.cloudflare.com/286469790a4362a2e194b32045c5eca7/odie-os-coding-session@sha256:a3ed11cff1c11faf8efd0fe4d1cebd7595026f791b8a6bc69b986e7ff9c5b1c1",
      "instance_type": "standard-4",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_SANDBOX", "class_name": "CodingSessionSandbox" },
      { "name": "SESSION_SANDBOX_STANDARD_2", "class_name": "CodingSessionSandboxStandard2" },
      { "name": "SESSION_SANDBOX_STANDARD_3", "class_name": "CodingSessionSandboxStandard3" },
      { "name": "SESSION_SANDBOX_STANDARD_4", "class_name": "CodingSessionSandboxStandard4" },
      { "name": "SESSION_CAPACITY", "class_name": "CodingSessionCapacity" },
      { "name": "SESSION_POLICIES", "class_name": "CodingSessionPolicy" },
      { "name": "SESSION_APPLICATION_PREVIEWS", "class_name": "CodingSessionApplicationPreview" },
      { "name": "SESSION_REGISTRIES", "class_name": "CodingSessionRegistry" }
    ]
  },
  "services": [
    {
      "binding": "WORKSHOP_TOOLS",
      "service": "odie-os-backend",
      "entrypoint": "CodingSessionToolHostImpl"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodingSessionSandbox", "CodingSessionRegistry", "CodingSessionPolicy"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GitHubOrganizationGatekeeper"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "CodingSessionSandboxStandard2",
        "CodingSessionSandboxStandard3",
        "CodingSessionSandboxStandard4",
        "CodingSessionCapacity"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["CodingSessionApplicationPreview"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
