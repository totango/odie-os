{
  "name": "@gadgets/gatekeeper-sessions",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "wrangler deploy",
    "build": "pnpm exec capnweb-validate build --out .wrangler/validate && tsc && tsc -p canary/tsconfig.json",
    "types:check": "tsc --noEmit && tsc -p canary/tsconfig.json",
    "test:run": "vitest run",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/sandbox": "0.13.0-next.751.1",
    "@gadgets/backend-utils": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "catalog:",
    "capnweb-validate": "catalog:"
  },
  "devDependencies": {
    "@gadgets/scripts": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "26.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
