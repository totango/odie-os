{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-work-items",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "enhanced_error_serialization", "global_fetch_strictly_public", "nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BASE_URL": "https://odie-os.odie-os.workers.dev/gatekeeper/work-items"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkItemsAccount", "WorkItemsGatekeeper"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
