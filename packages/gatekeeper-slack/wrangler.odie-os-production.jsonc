{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-slack",
  "main": ".wrangler/validate/src/slack.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BASE_URL": "https://odie-os.odie-os.workers.dev/gatekeeper/slack"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [
        "UserAccount",
        "SlackWorkspaceGatekeeperImpl",
        "SlackConversationGatekeeperImpl",
        "SlackThreadGatekeeperImpl"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
