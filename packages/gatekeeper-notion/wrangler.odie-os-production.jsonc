{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-notion",
  "main": ".wrangler/validate/src/notion.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "vars": {
    "BASE_URL": "https://odie-os.odie-os.workers.dev/gatekeeper/notion"
  },
  "migrations": [
    { "tag": "v0", "new_sqlite_classes": ["UserAccount", "NotionItemGatekeeperImpl", "NotionWorkspaceGatekeeperImpl"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
