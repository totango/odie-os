{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-scheduler",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScheduleDriver", "SchedulerGatekeeper"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
