{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "h",
    "types": ["./worker-configuration.d.ts"],
    "paths": {
      "@gadgets/backend-utils/*": ["../backend-utils/src/*"],
      "@gadgets/configurator-ui": ["../configurator-ui/src/index.ts"],
      "@gadgets/gatekeeper-work-items/*": ["../gatekeeper-work-items/src/*"],
      "@gadgets/workshop-shared/*": ["../workshop-shared/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", ".wrangler"]
}
