{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-team-pi",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "enhanced_error_serialization", "global_fetch_strictly_public", "nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }
  ],
  "vars": {
    "BASE_URL": "https://odie-os.odie-os.workers.dev/gatekeeper/team-pi",
    "TEAM_PI_AUTH0_DOMAIN": "https://auth.unison.totango.com",
    "TEAM_PI_AUTH0_CLIENT_ID": "C0G0uEoW9J8p8VKPgu9wBtIp0u2CpgxG",
    "TEAM_PI_AUTH0_AUDIENCE": "https://team-pi.totango.com/api",
    "TEAM_PI_BASE_URL": "https://team-pi-proxy.unison.totango.com"
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TeamPiAccount", "TeamPiGatekeeper"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
