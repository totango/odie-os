{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-team-pi",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src",
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "enhanced_error_serialization", "global_fetch_strictly_public", "nodejs_als"],
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TeamPiAccount", "TeamPiGatekeeper"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
