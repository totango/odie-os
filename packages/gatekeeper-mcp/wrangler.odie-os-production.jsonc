{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "odie-os-gk-mcp",
  "main": ".wrangler/validate/src/mcp.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["McpAccount", "McpGatekeeperImpl"]
    }
  ],
  "vars": {
    "BASE_URL": "https://odie-os.odie-os.workers.dev/gatekeeper/mcp",
    "MCP_ALLOW_INSECURE": "false",
    "MCP_CLIENT_NAME": "Odie OS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
